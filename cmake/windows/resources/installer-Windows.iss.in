[Code]

procedure TypesComboChange(Sender: TObject);
var
    I: Integer;
    InstalledVersion: Int64;
    ComingVersion: Int64;
begin
    for I := 0 to WizardForm.ComponentsList.Items.Count - 1 do begin
      if (WizardForm.ComponentsList.Items[I] = '3D Effect (Exeldro) ({#DEffectVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\3d-effect\3d-effect.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\3d-effect.dll'), InstalledVersion) or not StrToVersion('{#DEffectVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\3d-effect.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\3d-effect.dll'), InstalledVersion) or not StrToVersion('{#DEffectVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Advanced Masks (FiniteSingularity) ({#AdvancedMasksVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\obs-advanced-masks\obs-advanced-masks.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-advanced-masks.dll'), InstalledVersion) or not StrToVersion('{#AdvancedMasksVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\obs-advanced-masks.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-advanced-masks.dll'), InstalledVersion) or not StrToVersion('{#AdvancedMasksVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Composite Blur (FiniteSingularity) ({#CompositeBlurVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\obs-composite-blur\obs-composite-blur.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-composite-blur.dll'), InstalledVersion) or not StrToVersion('{#CompositeBlurVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\obs-composite-blur.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-composite-blur.dll'), InstalledVersion) or not StrToVersion('{#CompositeBlurVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Freeze Filter (Exeldro) ({#FreezeFilterVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\freeze-filter\freeze-filter.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\freeze-filter.dll'), InstalledVersion) or not StrToVersion('{#FreezeFilterVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\freeze-filter.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\freeze-filter.dll'), InstalledVersion) or not StrToVersion('{#FreezeFilterVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Gradient Source (Exeldro) ({#GradientSourceVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\gradient-source\gradient-source.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\gradient-source.dll'), InstalledVersion) or not StrToVersion('{#GradientSourceVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\gradient-source.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\gradient-source.dll'), InstalledVersion) or not StrToVersion('{#GradientSourceVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Move (Exeldro) ({#MoveVersion})') and FileExists(ExpandConstant('{app}\obs-plugins\64bit\move-transition.dll')) then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\move-transition\move-transition.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\move-transition.dll'), InstalledVersion) or not StrToVersion('{#MoveVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\move-transition.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\move-transition.dll'), InstalledVersion) or not StrToVersion('{#MoveVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Noise (FiniteSingularity) ({#NoiseVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\obs-noise\obs-noise.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-noise.dll'), InstalledVersion) or not StrToVersion('{#NoiseVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\obs-noise.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-noise.dll'), InstalledVersion) or not StrToVersion('{#NoiseVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Retro Effects (FiniteSingularity) ({#RetroEffectsVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\obs-retro-effects\obs-retro-effects.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-retro-effects.dll'), InstalledVersion) or not StrToVersion('{#RetroEffectsVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\obs-retro-effects.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-retro-effects.dll'), InstalledVersion) or not StrToVersion('{#RetroEffectsVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Scene Notes Dock (Exeldro) ({#SceneNotesDockVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\scene-notes-dock\scene-notes-dock.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\scene-notes-dock.dll'), InstalledVersion) or not StrToVersion('{#SceneNotesDockVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\scene-notes-dock.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\scene-notes-dock.dll'), InstalledVersion) or not StrToVersion('{#SceneNotesDockVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Source Clone (Exeldro) ({#SourceCloneVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\source-clone\source-clone.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\source-clone.dll'), InstalledVersion) or not StrToVersion('{#SourceCloneVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\source-clone.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\source-clone.dll'), InstalledVersion) or not StrToVersion('{#SourceCloneVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'Stroke Glow Shadow (FiniteSingularity) ({#StrokeGlowShadowVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\obs-stroke-glow-shadow\obs-stroke-glow-shadow.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-stroke-glow-shadow.dll'), InstalledVersion) or not StrToVersion('{#StrokeGlowShadowVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\obs-stroke-glow-shadow.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\obs-stroke-glow-shadow.dll'), InstalledVersion) or not StrToVersion('{#StrokeGlowShadowVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if (WizardForm.ComponentsList.Items[I] = 'SVG Source (FiniteSingularity) ({#SVGSourceVersion})') then begin
        if FileExists(ExpandConstant('{commonappdata}\obs-studio\plugins\svg-source\svg-source.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\svg-source.dll'), InstalledVersion) or not StrToVersion('{#SVGSourceVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end else if FileExists(ExpandConstant('{app}\obs-plugins\64bit\svg-source.dll')) and (not GetPackedVersion(ExpandConstant('{app}\obs-plugins\64bit\svg-source.dll'), InstalledVersion) or not StrToVersion('{#SVGSourceVersion}', ComingVersion) or (ComparePackedVersion(InstalledVersion, ComingVersion) >= 0)) then begin
          WizardForm.ComponentsList.Checked[I] := False;
          WizardForm.ComponentsList.ItemEnabled[I] := False;
        end;
      end;
      if WizardForm.ComponentsList.ItemEnabled[I] then begin
         if (WizardForm.TypesCombo.Text = 'Full installation') then begin
           WizardForm.ComponentsList.Checked[I] := True;
         end else if (WizardForm.TypesCombo.Text = 'Compact installation') then begin
           WizardForm.ComponentsList.Checked[I] := False;
         end;
      end;
    end;
end;

procedure InitializeWizard();
var
  GPLText: AnsiString;
  Page: TOutputMsgMemoWizardPage;
begin
  ExtractTemporaryFile('LICENSE');
  LoadStringFromFile(ExpandConstant('{tmp}\LICENSE'), GPLText);
  Page := CreateOutputMsgMemoPage(wpWelcome,
    'License Information', 'Please review the license terms before installing {#MyAppName}',
    'Press Page Down to see the rest of the agreement. Once you are aware of your rights, click Next to continue.',
    String(GPLText)
  );
  WizardForm.TypesCombo.OnChange := @TypesComboChange;
end;

// credit where it's due :
// following function come from https://github.com/Xaymar/obs-studio_amf-encoder-plugin/blob/master/%23Resources/Installer.in.iss#L45
function GetDirName(Value: string): string;
var
  InstallPath: string;
begin
  // initialize default path, which will be returned when the following registry
  // key queries fail due to missing keys or for some different reason
  Result := ExpandConstant('{pf}\obs-studio');
  // query the first registry value; if this succeeds, return the obtained value
  if RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath;
  if RegQueryStringValue(HKLM64, 'SOFTWARE\OBS Studio', '', InstallPath) then
    Result := InstallPath;
end;

/////////////////////////////////////////////////////////////////////
function NextButtonClick(PageId: Integer): Boolean;
var
    ObsFileName: string;
    ObsMS, ObsLS: Cardinal;
    ObsMajorVersion, ObsMinorVersion: Cardinal;
begin
    Result := True;
    if not (PageId = wpSelectDir) then begin
        exit;
    end;
    ObsFileName := ExpandConstant('{app}\bin\64bit\obs64.exe');
    if not FileExists(ObsFileName) then begin
        MsgBox('OBS Studio (bin\64bit\obs64.exe) does not seem to be installed in that folder.  Please select the correct folder.', mbError, MB_OK);
        Result := False;
        exit;
    end;
    Result := GetVersionNumbers(ObsFileName, ObsMS, ObsLS);
    if not Result then begin
        MsgBox('Failed to read version from OBS Studio (bin\64bit\obs64.exe).', mbError, MB_OK);
        Result := False;
        exit;
    end;
    { shift 16 bits to the right to get major version }
    ObsMajorVersion := ObsMS shr 16; 
    { select only low 16 bits }
    ObsMinorVersion := ObsMS and $FFFF;
    if ObsMajorVersion < 31 then begin
        MsgBox('Version of OBS Studio (bin\64bit\obs64.exe) is lower than the version 31 required.', mbError, MB_OK);
        Result := False;
        exit;
    end;
    TypesComboChange(nil);
end;

procedure CurPageChanged(CurPageID: Integer);
begin
    if CurPageID = wpSelectComponents then begin
        TypesComboChange(nil);
        exit;
    end;
end;
